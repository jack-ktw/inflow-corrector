FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    #include            "include/ABLConditions"

    left
    {
        type            symmetryPlane;
    }
    right
    {
        type            symmetryPlane;
    }
    ground
    {
        type            atmNutkWallFunction;
	kappa		$kappa;
	Cmu		$Cmu;
        z0              $z0;
        value           uniform 0.0;
    }
    atm
    {
        type            symmetryPlane;
//	value		uniform 0;
    }
    outlet
    {
        type            calculated;
        value           uniform 0;
    }
    inlet
    {
        type            calculated;
        value           uniform 0;
    }

    wall
    {
        type            nutkWallFunction;
        value           uniform 0;
        blending	exponential;
    }

    #include "include/setConstraintTypes"
    // #includeEtc "caseDicts/setConstraintTypes"

    /*
    east
    {
        type            nutkWallFunction;
        value           uniform 0;
    }
    west
    {
        type            nutkWallFunction;
        value           uniform 0;
    }
    sur
    {
        type            nutkWallFunction;
        value           uniform 0;
    }
    */

}


