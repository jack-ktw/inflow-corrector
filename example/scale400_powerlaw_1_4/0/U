FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    left
    {
        type            symmetryPlane;
    }
    right
    {
        type            symmetryPlane;
    }
    ground
    {
        type            noSlip;
    }
    atm
    {
        type 		symmetryPlane;
//	tau 		(1.346 0 0);
//	value 		uniform (0 0 0);
    }
    outlet
    {
        type            zeroGradient;
    }

    inlet
    {
        type            atmBoundaryLayerInletVelocity;
        #include        "include/ABLConditions"
        value           uniform (0 0 0);
    }

    wall
    {
        type            noSlip;
    }

    #include "include/setConstraintTypes"
    // #includeEtc "caseDicts/setConstraintTypes"

