FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    left
    {
        type            symmetryPlane;
    }
    right
    {
        type            symmetryPlane;
    }
    ground
    {
        type            zeroGradient;
    }
    atm
    {
        type            symmetryPlane;
    }
    outlet
    {
        type            fixedValue;
        value           uniform 0;
    }
    inlet
    {
        type            zeroGradient;
    }

    wall
    {
        type            zeroGradient;
    }

    #include "include/setConstraintTypes"
    // #includeEtc "caseDicts/setConstraintTypes"

    /*
    east
    {
        type            zeroGradient;
    }
    west
    {
        type            zeroGradient;
    }
    sur
    {
        type            zeroGradient;
    }
    */

}


