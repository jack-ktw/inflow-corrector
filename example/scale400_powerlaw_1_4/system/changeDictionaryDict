FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      changeDictionaryDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

nut
{
    boundaryField
    {
      building
      {
          type            nutUSpaldingWallFunction;
          value           uniform 0.2;
      }
      ground
      {
          type            atmNutUWallFunction;
          z0              uniform 0.012375;
          value           uniform 0.2;
      }
    }
}

U
{
boundaryField
    {
      inlet
      {
          type            timeVaryingMappedFixedValue;
          fieldTable      U;
          value           uniform (0 0 0);
      }
    }
}

